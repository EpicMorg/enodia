1 ICON "enodia.ico"
1 24 "manifest.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_CSV@
PRODUCTVERSION @VERSION_CSV@
FILEOS 0x4
FILETYPE 0x1
{
BLOCK "StringFileInfo"
{
	BLOCK "000004b0"
	{
		VALUE "Comments", "https://github.com/EpicMorg/enodia"
		VALUE "CompanyName", "EpicMorg"
		VALUE "FileDescription", "enodia: service inventory and lifecycle (EOL) monitoring"
		VALUE "FileVersion", "@VERSION_STR@"
		VALUE "InternalName", "enodia"
		VALUE "LegalCopyright", "Copyright (C) EpicMorg. Licensed under AGPL-3.0-or-later."
		VALUE "OriginalFilename", "enodia.exe"
		VALUE "ProductName", "enodia"
		VALUE "ProductVersion", "@VERSION_STR@"
	}
}

BLOCK "VarFileInfo"
{
	VALUE "Translation", 0x0000, 0x04B0
}
}
